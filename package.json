{
  "name": "@theluckystrike/mcp-petty-cash",
  "version": "0.21.0",
  "description": "A petty cash float on the imprest system: vouchers, reconciliation and the replenishment.",
  "type": "module",
  "bin": {
    "mcp-petty-cash": "dist/index.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --declaration && node -e \"import('node:fs').then(f=>f.chmodSync('dist/index.js',0o755))\"",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "petty-cash",
    "imprest",
    "float",
    "voucher",
    "reconciliation",
    "accounting"
  ],
  "license": "MIT",
  "author": "theluckystrike",
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/mcp-servers",
    "directory": "servers/petty-cash"
  },
  "homepage": "https://github.com/theluckystrike/mcp-servers/tree/main/servers/petty-cash",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@theluckystrike/mcp-asset-register": "file:vendor/mcp-asset-register",
    "@theluckystrike/mcp-cash-book": "file:vendor/mcp-cash-book",
    "@theluckystrike/mcp-license": "file:vendor/mcp-license",
    "@theluckystrike/mcp-quotes": "file:vendor/mcp-quotes",
    "@theluckystrike/mcp-timezone": "file:vendor/mcp-timezone",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
