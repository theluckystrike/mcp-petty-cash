  },
  "homepage": "https://github.com/theluckystrike/mcp-servers/tree/main/servers/cash-book",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@theluckystrike/mcp-asset-register": "file:../mcp-asset-register",
    "@theluckystrike/mcp-billing-docs": "file:../mcp-billing-docs",
    "@theluckystrike/mcp-deposits": "file:../mcp-deposits",
    "@theluckystrike/mcp-invoice": "file:../mcp-invoice",
    "@theluckystrike/mcp-license": "file:../mcp-license",
    "@theluckystrike/mcp-quotes": "file:../mcp-quotes",
    "@theluckystrike/mcp-statement-of-account": "file:../mcp-statement-of-account",
    "zod": "^3.25.0"
  }
}
