{
  "name": "@theluckystrike/mcp-cash-book",
  "version": "0.22.0",
  "description": "One double-entry ledger derived from your invoices, bank, expenses, deposits and assets.",
  "type": "module",
  "bin": {
    "mcp-cash-book": "dist/index.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cash-book",
    "double-entry",
    "general-ledger",
    "trial-balance",
    "bookkeeping",
    "accounting"
  ],
  "license": "MIT",
  "author": "theluckystrike",
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/mcp-servers",
